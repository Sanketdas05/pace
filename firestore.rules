rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection
    match /tasks/{taskId} {
      // Anyone who is logged in can create a task
      allow create: if request.auth != null;
      
      // Allow reading if the user is the owner or a member
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.auth.uid in resource.data.members
      );
      
      // Allow updating if user is owner, member, or if they are joining a team task (only appending their UID)
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.auth.uid in resource.data.members ||
        (resource.data.type == 'team' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && request.resource.data.members.hasAll([request.auth.uid]))
      );
      
      // Only owner can delete
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Task messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/tasks/$(taskId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.members
        );
      }
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notes collection
    match /notes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
